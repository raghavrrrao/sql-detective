# Copy this file to .env before local development or deployment.
# Client variables must begin with VITE_ to be exposed to the browser.
VITE_API_BASE_URL=/api

# Server settings
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_PATH=../database/sql-detective.sqlite
NODE_ENV=development
QUERY_TIMEOUT_MS=2000
QUERY_ROW_LIMIT=200
